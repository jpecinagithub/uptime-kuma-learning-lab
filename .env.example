# =============================================================================
# Uptime Kuma Educational Monitoring Lab — variables de entorno (PLANTILLA)
# =============================================================================
# COPIA este archivo como ".env" y rellena tus valores:
#     cp .env.example .env
# El script install.sh lo hace por ti si no existe.
#
# ⚠️  .env contiene SECRETOS. Nunca se sube a Git (está en .gitignore) y
#     nunca se incluye en backups salvo que pidas --include-secrets.
# =============================================================================

# Modo de datos del dashboard: auto | real | demo
#   auto → intenta datos reales de Uptime Kuma; si no puede, usa demo (avisando).
#   real → solo datos reales; si Kuma no responde, la API devuelve error claro.
#   demo → datos simulados para explorar sin Uptime Kuma.
MODE=auto

# URL interna de Uptime Kuma DENTRO de la red Docker (nombre del servicio).
# No la cambies salvo que renombres el servicio en docker-compose.yml.
KUMA_URL=http://uptime-kuma:3001

# Credenciales del administrador de Uptime Kuma.
# Se crean la PRIMERA vez que entras a http://localhost:3001 vía túnel SSH.
# install.sh te las pide (sin mostrarlas) solo si están vacías.
# El backend las usa para leer monitores; el NAVEGADOR nunca las ve.
UK_USERNAME=
UK_PASSWORD=

# (Opcional) API key de Uptime Kuma si prefieres autenticar el adapter con
# clave en lugar de usuario/contraseña. Déjala vacía si no la usas.
KUMA_METRICS_API_KEY=

# Si es true, monitoring-api crea al arrancar monitores de ejemplo en Kuma:
# el propio dashboard, una web pública fiable, un endpoint HTTP de pruebas,
# un servicio TCP, un ping y el test-service (para el Chaos Lab).
SEED_MONITORS=true

# URL interna del test-service (nombre Docker, red lab-net). No cambiar.
TEST_SERVICE_URL=http://test-service:3000

# Secreto compartido entre monitoring-api y test-service para el Chaos Lab.
# El frontend NUNCA lo conoce: llama a /api/chaos y el backend reenvía
# la petición con este secreto en la cabecera x-admin-secret.
# Generar uno nuevo con:  openssl rand -hex 32
# install.sh lo genera automáticamente si dejas esta línea vacía.
TEST_SERVICE_SECRET=

# Zona horaria para logs y marcas de tiempo.
TZ=Europe/Madrid
